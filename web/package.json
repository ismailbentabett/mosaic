{
  "name": "mosaic-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && vite",
    "dev:mock": "node init && vite --mode mock",
    "dev:demo": "node init && vite --mode demo",
    "build": "node init && vite build",
    "build:demo": "node init && vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "build:native": "node init && vite build --mode demo --base=./ --outDir dist-native",
    "android": "npm run build:native && npx cap add android && npx cap sync android",
    "windows": "npm run build:native && npx tauri build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "lint:ui": "node scripts/ui-lint.mjs",
    "audit": "node scripts/ui-audit.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint:ui && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.2",
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/charts": "9.7.4",
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@tabler/icons-react": "3.51.0",
    "dayjs": "1.11.23",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "^1.58.2",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
