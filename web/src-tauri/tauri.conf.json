{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic",
  "version": "../package.json",
  "identifier": "io.github.ismailbentabett.mosaic",
  "build": {
    "frontendDist": "../dist-native",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mosaic",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "Ismail Bentabett",
    "shortDescription": "Mosaic, the everything app",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
