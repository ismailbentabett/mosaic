# Mosaic API environment. Copy to .env (or export these) and fill only what you need.
# Every integration is optional: leave a value empty and that feature reports "not connected".
# Secrets (marked [secret]) can also live in $MOSAIC_SECRETS instead of the environment.

# ---------- Paths and server ----------
# Base folder for services/config.env, logs/, vault/ and scheduled prompts (default ~/mosaic).
MOSAIC_ROOT=
# Secrets file, KEY=value per line, mode 600 (default ~/.config/mosaic/secrets.env).
MOSAIC_SECRETS=
# Data folder for app.db, media and backups (default ~/.local/share/mosaic).
MOSAIC_DATA=
# Full path of the SQLite database (default $MOSAIC_DATA/app.db).
MOSAIC_DB=
# Markdown notes vault (default $MOSAIC_ROOT/vault).
MOSAIC_VAULT=
# Built web client served as static files (default $MOSAIC_ROOT/app/web/dist).
MOSAIC_WEB_DIST=
# Port the API listens on, 127.0.0.1 only (default 8787).
MOSAIC_API_PORT=8787
# Public origin of the app, used for CORS, cookies and links (default http://localhost:8787).
MOSAIC_PUBLIC_URL=http://localhost:8787
# 1 = dev mode: no sign-in and MCP over HTTP on. Local development only, never on a public host.
MOSAIC_DEV=
# Display name returned by GET /api/me (default Sam).
MOSAIC_OWNER_NAME=
# Path of the bundled stdio MCP entry that chat runs spawn (default dist/mcp-stdio.js next to the server).
MOSAIC_MCP_ENTRY=
# Source tag the stdio MCP server writes into the action log (default vps-claude).
MOSAIC_SOURCE=

# ---------- Location (weather) ----------
# Latitude, longitude and city name (default London: 51.5, -0.13).
MOSAIC_LAT=
MOSAIC_LNG=
MOSAIC_CITY=
# IANA timezone for "today", reminders and life-days, e.g. Europe/London or America/New_York.
# Falls back to TZ, then UTC.
MOSAIC_TZ=

# ---------- Sign-in (set with the CLI: password, owner-email, 2fa-setup) ----------
# [secret] Only email that can sign in.
MOSAIC_OWNER_EMAIL=
# [secret] scrypt hash of the app password (written by `cli password`, never the password itself).
MOSAIC_APP_PASSWORD_HASH=
# [secret] Active TOTP secret, a pending one during setup, and hashed recovery codes.
MOSAIC_TOTP_SECRET=
MOSAIC_TOTP_PENDING=
MOSAIC_TOTP_RECOVERY=
# [secret] Key that signs one-tap notification action links (generated on first use).
MOSAIC_ACTION_KEY=
# [secret] sha256 of the screen-time ingest token (written by `cli ingest-token`).
MOSAIC_INGEST_HASH=

# ---------- Claude (chat tab, nightly plan) ----------
# Claude Code CLI binary (default `claude` on PATH). Missing binary = chat says "Claude CLI not found".
CLAUDE_BIN=
# [secret] OAuth token for the Claude CLI.
CLAUDE_CODE_OAUTH_TOKEN=

# ---------- Google Calendar and Sheets ----------
# [secret] OAuth client and refresh token. All three unset = calendar and sheet features off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to read and write (default primary).
GOOGLE_CALENDAR_ID=primary
# Optional Google Sheet id for the mode cell and money totals. Unset = sheet calls return 400 "SHEET_ID not set".
SHEET_ID=

# ---------- Push notifications (self-hosted ntfy on 127.0.0.1) ----------
# Local ntfy port (default 2586). No ntfy running = pushes are logged as failed, nothing else breaks.
NTFY_PORT=2586
# Topic for life pushes (default mosaic) and for ops/health pushes (default same as NTFY_TOPIC).
NTFY_TOPIC=mosaic
NTFY_OPS_TOPIC=
# [secret] ntfy access token for publishing.
NTFY_BOT_TOKEN=

# ---------- Ops ----------
# Syncthing GUI port checked by `cli health` (default 8384).
SYNCTHING_GUI_PORT=
# ---------- Encrypted backups (`cli backup`, `cli backup-list`, `cli restore`; see docs/BACKUPS.md) ----------
# Local folder for encrypted snapshots, also checked by `cli health` (default $MOSAIC_ROOT/backups/archive).
BACKUP_DIR=
# How many snapshots to keep, locally and in the bucket (default 14).
MOSAIC_BACKUP_KEEP=
# [secret] Passphrase for AES-256-GCM (scrypt-derived key), at least 12 characters. Lose it = backups are unreadable.
MOSAIC_BACKUP_PASSPHRASE=
# Any S3-compatible store (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi). All four set = upload on.
MOSAIC_S3_ENDPOINT=
MOSAIC_S3_BUCKET=
# Region for signing (default auto; R2 uses auto, AWS needs the real region).
MOSAIC_S3_REGION=
# Key prefix inside the bucket (default mosaic/).
MOSAIC_S3_PREFIX=
# [secret] Access key pair with put/get/list/delete on the bucket only.
MOSAIC_S3_ACCESS_KEY_ID=
MOSAIC_S3_SECRET_ACCESS_KEY=
# ---------- Ops (continued) ----------
# 1 = last retry of the nightly job: push a notice instead of asking cron to retry.
RUN_FINAL=

# ---------- Plugins (docs/PLUGINS.md) ----------
# Folder of community plugins: one file or folder (with index.ts) per plugin. Empty = no plugins.
MOSAIC_PLUGINS_DIR=
